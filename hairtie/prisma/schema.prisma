// Hairtie — premium D2C fashion & accessories commerce platform
// Database: PostgreSQL (works with Supabase, Neon, RDS or any managed Postgres)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Accounts & authentication
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  phone        String?
  name         String
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  notes        String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses  Address[]
  orders     Order[]
  reviews    Review[]
  wishlist   WishlistItem[]
  cart       Cart?
  redemtions CouponRedemption[]

  @@index([role])
  @@index([createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String   @default("India")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  imageUrl    String?
  imageAlt    String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  position   Int     @default(0)
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)

  seoTitle       String?
  seoDescription String?

  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([parentId])
  @@index([position])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String  @unique
  brand            String  @default("Hairtie")
  shortDescription String?
  description      String  @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Pricing — all money stored in paise (integer) to avoid float rounding errors
  mrp       Int  @default(0)
  price     Int  @default(0)
  costPrice Int?

  // Inventory
  stock              Int     @default(0)
  lowStockThreshold  Int     @default(5)
  trackInventory     Boolean @default(true)
  allowBackorder     Boolean @default(false)

  // Tax — required for Indian invoicing and marketplace listings
  hsnCode      String?
  gstRate      Int     @default(5) // percent
  priceIncludesTax Boolean @default(true)

  // Physical attributes — required by Amazon / Flipkart / Myntra feeds
  weightGrams Int?
  lengthCm    Float?
  widthCm     Float?
  heightCm    Float?
  material    String?
  careInstructions String?
  countryOfOrigin  String  @default("India")

  // Media
  videoUrl String?

  // Merchandising flags
  isNewArrival Boolean @default(false)
  isBestseller Boolean @default(false)
  isTrending   Boolean @default(false)
  isFeatured   Boolean @default(false)
  isOnSale     Boolean @default(false)

  status      ProductStatus @default(ACTIVE)
  position    Int           @default(0)
  publishedAt DateTime?

  // SEO
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImageUrl     String?
  canonicalUrl   String?

  // Denormalised counters, kept in sync by the app
  viewCount   Int   @default(0)
  salesCount  Int   @default(0)
  ratingSum   Int   @default(0)
  reviewCount Int   @default(0)

  images     ProductImage[]
  variants   ProductVariant[]
  attributes ProductAttribute[]
  tags       ProductTag[]
  reviews    Review[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlisted WishlistItem[]
  lookItems  LookProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([createdAt])
  @@index([salesCount])
  @@index([price])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  position  Int     @default(0)
  width     Int?
  height    Int?

  @@index([productId, position])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  name     String // e.g. "Blush / Medium"
  sku      String  @unique
  color    String?
  colorHex String?
  size     String?
  price    Int? // overrides product price when set
  mrp      Int?
  stock    Int     @default(0)
  imageUrl String?
  position Int     @default(0)
  isActive Boolean @default(true)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

/// Free-form product specifications. Lets the client add new attributes
/// (strap type, compartments, closure, occasion...) without a schema change.
model ProductAttribute {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  group     String  @default("Specifications")
  position  Int     @default(0)

  @@index([productId, position])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  products ProductTag[]
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Cart & wishlist
// ---------------------------------------------------------------------------

model Cart {
  id        String     @id @default(cuid())
  token     String     @unique // anonymous cart cookie
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(cuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity  Int             @default(1)
  savedForLater Boolean     @default(false)
  createdAt DateTime        @default(now())

  @@unique([cartId, productId, variantId])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Customer snapshot — orders stay readable even if the account is deleted
  customerName  String
  customerEmail String
  customerPhone String

  shippingLine1   String
  shippingLine2   String?
  shippingCity    String
  shippingState   String
  shippingPincode String
  shippingCountry String  @default("India")

  // Money, in paise
  subtotal       Int @default(0)
  discountAmount Int @default(0)
  shippingFee    Int @default(0)
  taxAmount      Int @default(0)
  total          Int @default(0)

  couponCode String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod PaymentMethod @default(COD)

  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  refundId          String?
  refundAmount      Int     @default(0)

  courierName    String?
  trackingNumber String?
  trackingUrl    String?
  customerNote   String?
  adminNote      String?

  placedAt    DateTime  @default(now())
  confirmedAt DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime  @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([status])
  @@index([paymentStatus])
  @@index([placedAt])
  @@index([customerEmail])
  @@index([customerPhone])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot at purchase time
  name        String
  sku         String
  variantName String?
  imageUrl    String?
  price       Int
  mrp         Int     @default(0)
  gstRate     Int     @default(5)
  hsnCode     String?
  quantity    Int     @default(1)
  lineTotal   Int     @default(0)

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  message   String
  createdBy String? // admin user name, or "system"
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

// ---------------------------------------------------------------------------
// Discounts
// ---------------------------------------------------------------------------

enum DiscountType {
  PERCENT
  FIXED
}

enum CouponScope {
  ALL
  PRODUCTS
  CATEGORIES
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  description String?
  type        DiscountType @default(PERCENT)
  value       Int          @default(0) // percent, or paise for FIXED

  minOrderValue Int  @default(0) // paise
  maxDiscount   Int? // paise, caps a percentage discount

  scope        CouponScope @default(ALL)
  productIds   String[]    @default([])
  categoryIds  String[]    @default([])

  firstOrderOnly Boolean @default(false)
  usageLimit     Int? // total redemptions allowed
  perUserLimit   Int     @default(1)
  usageCount     Int     @default(0)

  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  redemptions CouponRedemption[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model CouponRedemption {
  id       String   @id @default(cuid())
  couponId String
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId  String?
  email    String?
  amount   Int      @default(0)
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  authorName  String
  authorEmail String?
  rating      Int          @default(5)
  title       String?
  body        String
  status      ReviewStatus @default(PENDING)
  isVerified  Boolean      @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// CMS — visual website editor
// ---------------------------------------------------------------------------

model Page {
  id       String  @id @default(cuid())
  slug     String  @unique // "home", "about", "contact"...
  title    String
  isSystem Boolean @default(false) // system pages cannot be deleted
  isPublished Boolean @default(true)

  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  sections Section[]

  /// Last published snapshot of the sections, used to power Preview → Publish
  publishedSnapshot Json?
  hasDraftChanges   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id       String  @id @default(cuid())
  pageId   String
  page     Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type     String // "hero", "productGrid", "instagram"...
  position Int     @default(0)
  isHidden Boolean @default(false)
  settings Json    @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, position])
}

/// "Shop the look" — a lifestyle image with products tagged on it
model Look {
  id        String        @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  imageAlt  String        @default("")
  position  Int           @default(0)
  isActive  Boolean       @default(true)
  products  LookProduct[]
  createdAt DateTime      @default(now())
}

model LookProduct {
  lookId    String
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position  Int     @default(0)

  @@id([lookId, productId])
}

// ---------------------------------------------------------------------------
// Media library
// ---------------------------------------------------------------------------

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  width     Int?
  height    Int?
  sizeBytes Int      @default(0)
  alt       String   @default("")
  folder    String   @default("Uploads")
  createdAt DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Settings — one row each, edited from the admin panel
// ---------------------------------------------------------------------------

model SiteSetting {
  id    String @id @default("singleton")
  data  Json   @default("{}")
  updatedAt DateTime @updatedAt
}

model ThemeSetting {
  id        String   @id @default("singleton")
  data      Json     @default("{}")
  draft     Json?
  updatedAt DateTime @updatedAt
}
