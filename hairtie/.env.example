# ---------------------------------------------------------------------------
# Hairtie — environment variables
#
# NOTHING HERE IS REQUIRED. The shop runs with no configuration at all:
#   npm install && npm run dev
#
# Everything below is optional, and only switches on an extra feature.
# Copy this file to `.env` when you need one of them. Never commit `.env`.
# ---------------------------------------------------------------------------

# The public address of the site, used for canonical URLs, the sitemap and the
# preview card when someone shares a link. Can also be set in
# Admin → Store Settings → SEO.
NEXT_PUBLIC_SITE_URL="https://hairtie.in"

# ---------------------------------------------------------------------------
# Online payments — Razorpay (optional)
#
# Until both keys are set, checkout offers Cash on Delivery only and the online
# payment option stays hidden. Nothing pretends to work.
# Get them at https://dashboard.razorpay.com → Settings → API Keys.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional. Set the same secret in Razorpay → Settings → Webhooks, pointing at
# https://your-domain/api/payments/razorpay/webhook. It is a safety net: if a
# customer closes the browser after paying, this still marks the order paid.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Where uploaded images go (optional)
#
#   local     — the default. Saves into /public/uploads on the server's disk.
#   supabase  — uploads to a Supabase Storage bucket. Use this if you deploy to
#               Vercel or another host with a read-only filesystem.
# ---------------------------------------------------------------------------
MEDIA_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hairtie-media"
