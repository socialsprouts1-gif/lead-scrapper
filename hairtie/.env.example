# ---------------------------------------------------------------------------
# Hairtie — environment variables
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED — PostgreSQL connection string (Supabase, Neon, RDS or self-hosted).
# Supabase users: use the "Connection pooling" string for DATABASE_URL.
DATABASE_URL="postgresql://user:password@localhost:5432/hairtie?schema=public"

# REQUIRED — signs the login cookie. Use a long random string (32+ characters).
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=""

# The public address of the site, used for canonical URLs, the sitemap and
# Open Graph tags. Can also be set from Admin → Store Settings → SEO.
NEXT_PUBLIC_SITE_URL="https://hairtie.in"

# ---------------------------------------------------------------------------
# Payments — Razorpay (optional)
# Until these are set, the storefront hides online payment and offers Cash on
# Delivery only. Nothing pretends to work.
# Get them at https://dashboard.razorpay.com → Settings → API Keys.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Optional: set the same secret in Razorpay → Settings → Webhooks, pointing at
# https://your-domain/api/payments/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Media storage
#   local     — writes to /public/uploads. Good for a VPS; NOT suitable for
#               Vercel, whose filesystem is read-only.
#   supabase  — uploads to a Supabase Storage bucket. Recommended for Vercel.
# ---------------------------------------------------------------------------
MEDIA_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hairtie-media"

# ---------------------------------------------------------------------------
# First admin account, used only by `npm run db:seed`
# Change the password immediately after the first sign-in.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@hairtie.in"
SEED_ADMIN_PASSWORD="change-this-password"
