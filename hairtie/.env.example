# ---------------------------------------------------------------------------
# Hairtie — environment variables
#
# NOTHING HERE IS REQUIRED. The shop runs with no configuration at all:
#   npm install && npm run dev
#
# Everything below is optional, and only switches on an extra feature.
# Copy this file to `.env` when you need one of them. Never commit `.env`.
# ---------------------------------------------------------------------------

# The public address of the site, used for canonical URLs, the sitemap and the
# preview card when someone shares a link. Can also be set in
# Admin → Store Settings → SEO.
NEXT_PUBLIC_SITE_URL="https://hairtie.in"

# ---------------------------------------------------------------------------
# The shop manager's password — SET THIS BEFORE THE SITE IS PUBLIC
#
# Leave it empty and /admin is open to anyone who finds the URL, which is fine
# on your own machine and is how the shop ships. On a public address, set a
# long password here: /admin then asks for it once per device.
#
# On Vercel: Project → Settings → Environment Variables → add ADMIN_PASSWORD,
# then redeploy.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
# Where the shop is saved
#
# The whole shop — products, orders, page edits, gateway keys — is one JSON
# document. Where it lives is worked out automatically:
#
#   Vercel Blob   when BLOB_READ_WRITE_TOKEN is set (see below)
#   the disk      `.data/hairtie.json`, on any host with a writable filesystem
#   memory        neither of the above — everything works, but every change is
#                 lost when the server restarts, customer orders included
#
# Vercel's filesystem is read-only, so on Vercel you MUST connect a Blob store
# or the shop cannot save anything:
#   Vercel dashboard → Storage → Create → Blob → connect it to this project.
# Vercel then sets BLOB_READ_WRITE_TOKEN for you; you do not paste it here.
# The shop's own blob is private — it holds customer addresses and your
# payment keys, and is never readable from a URL.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Online payments — Razorpay (optional)
#
# Until both keys are set, checkout offers Cash on Delivery only and the online
# payment option stays hidden. Nothing pretends to work.
# Get them at https://dashboard.razorpay.com → Settings → API Keys.
# ---------------------------------------------------------------------------
# These are a fallback: the same keys can be entered in Admin → Payments,
# which is easier and needs no redeploy. A value here is used only when the
# matching field in the admin is left blank.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Optional. Set the same secret in Razorpay → Settings → Webhooks, pointing at
# https://your-domain/api/payments/razorpay/webhook. It is a safety net: if a
# customer closes the browser after paying, this still marks the order paid.
RAZORPAY_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Where uploaded images go (optional)
#
#   blob      — Vercel Blob. Chosen automatically when BLOB_READ_WRITE_TOKEN is
#               set, so on Vercel image uploads just work.
#   local     — saves into /public/uploads on the server's disk. The default on
#               a host with a writable filesystem.
#   supabase  — uploads to a Supabase Storage bucket.
#
# Leave MEDIA_DRIVER empty to let the shop pick. Set it only to override.
# ---------------------------------------------------------------------------
MEDIA_DRIVER=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="hairtie-media"
